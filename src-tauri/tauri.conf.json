{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anedikit",
  "version": "0.4.0",
  "identifier": "com.user.anedikit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnEdiKit",
        "width": 1100,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "windowEffects": {
          "effects": ["acrylic", "mica", "blur"]
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
